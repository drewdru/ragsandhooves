<mjml>
  <mj-head>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-text font-size="14px" />
      <mj-text line-height="27.2px" />
      <mj-text font-weight="400" />
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans','Helvetica Neue', sans-serif" />
      <mj-text font-size="14px" />
      <mj-text color="#000000" />
      <mj-text line-height="27.2px" />
      <mj-text font-weight="400" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fafbfc" width="600px">
    <mj-section padding="40px 20px 40px 20px" border="none" direction="ltr" text-align="center" background-repeat="repeat" background-size="auto" background-color="#fff">
      <mj-column border="none" vertical-align="middle" width="100%" padding="0px 0px 0px 0px">
        <mj-text align="center" font-size="20px" color="#333" padding="35px 35px 35px 35px">{{ project_name }} - {{ _("email.new_account") }}</mj-text>
        <mj-text align="center" font-size="16px" font-family="Arial, Helvetica, sans-serif" color="#555" padding="10px 25px 10px 25px"><span>{{ _("email.welcome_new_account") }}</span></mj-text>
        <mj-text align="center" font-size="16px" font-family="Arial, Helvetica, sans-serif" color="#555" padding="10px 25px 10px 25px">{{ _("email.verify_email") }}</mj-text>
        <mj-button align="center" background-color="#009688" color="#fff" font-weight="normal" border-radius="8px" line-height="120%" target="_blank" vertical-align="middle" border="none" text-align="center" href="{{ link }}" font-size="18px" padding="15px 30px 15px 30px">{{ _("email.verify_email_subject") }}</mj-button>
        <mj-divider border-width="2px" border-style="solid" border-color="#ccc" padding="10px 0px 10px 0px"></mj-divider>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>